# PROOF_OF_DONE=off disables the hook entirely for this shell/session.
# PROOF_OF_DONE=off

# PROOF_OF_DONE_MODE overrides the configured mode (block or warn).
# PROOF_OF_DONE_MODE=warn

# PROOF_OF_DONE_CONFIG points at an extra config file layered above the project config.
# PROOF_OF_DONE_CONFIG=/path/to/config.yaml

# PROOF_OF_DONE_PYTHON overrides the python3 interpreter the hook launcher uses.
# PROOF_OF_DONE_PYTHON=/usr/bin/python3

# PROOF_OF_DONE_SALT seeds the counter/session hashing so it differs across installs.
# PROOF_OF_DONE_SALT=some-random-string
